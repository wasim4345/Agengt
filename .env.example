# Server-side only. Copy this file to a new file named .env.local.
# Never prefix these with NEXT_PUBLIC_ — that would show them in the browser.

XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4.7

# Buffer (primary destination). Create an App Client in Buffer → Settings → API.
# Public clients only need BUFFER_CLIENT_ID. Private clients also set the secret.
BUFFER_CLIENT_ID=your_buffer_client_id_here
BUFFER_CLIENT_SECRET=your_buffer_client_secret_here
SESSION_SECRET=a_long_random_string_you_make_up
